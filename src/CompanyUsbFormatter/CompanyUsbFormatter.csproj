<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <AssemblyName>CompanyUsbFormatter</AssemblyName>
    <RootNamespace>CompanyUsbFormatter</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Company USB Formatter</AssemblyTitle>
    <Description>Technician utility for guarded exFAT formatting of USB disks.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
